{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:concurrency": "bun test test/concurrency --timeout 120000",
    "migration:up": "bun run src/infrastructure/persistence/migrate.ts up",
    "migration:down": "bun run src/infrastructure/persistence/migrate.ts down",
    "test:load": "bun run test/load/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@mikro-orm/core": "^7.2.6",
    "@mikro-orm/migrations": "^7.2.6",
    "@mikro-orm/postgresql": "^7.2.6",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "typescript": "^7.0.2"
  }
}
